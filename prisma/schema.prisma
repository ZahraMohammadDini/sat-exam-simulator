generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────
// Student
// ─────────────────────────────────────────────────────────────────
model Student {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     TestSession[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────
// Test
// ─────────────────────────────────────────────────────────────────
model Test {
  id               String        @id @default(cuid())
  title            String
  description      String?
  passwordHash     String
  isPublished      Boolean       @default(false)
  allowReview      Boolean       @default(true)
  showExplanations Boolean       @default(true)
  adaptiveEnabled  Boolean       @default(false)
  modules          TestModule[]
  sessions         TestSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isPublished])
}

// ─────────────────────────────────────────────────────────────────
// TestModule
// ─────────────────────────────────────────────────────────────────
model TestModule {
  id                String                @id @default(cuid())
  testId            String
  test              Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  subject           String
  moduleNumber      Int
  difficulty        String                @default("standard")
  timeLimitSeconds  Int
  order             Int
  adaptiveThreshold Int?
  routesTo          String?
  questions         TestModuleQuestion[]
  createdAt         DateTime              @default(now())

  @@index([testId, order])
}

// ─────────────────────────────────────────────────────────────────
// Question
// ─────────────────────────────────────────────────────────────────
model Question {
  id         String   @id @default(cuid())
  subject    String
  type       String
  difficulty String   @default("medium")
  domain     String?
  tags       String[]

  passage        String?
  passageImage   String?
  passageIsImage Boolean @default(false)

  stem        String?
  stemImage   String?
  stemIsImage Boolean @default(false)

  choices       Json?
  correctAnswer String

  explanation        String?
  explanationImage   String?
  explanationIsImage Boolean @default(false)

  isPublished Boolean              @default(true)
  modules     TestModuleQuestion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([subject, difficulty])
  @@index([isPublished])
}

// ─────────────────────────────────────────────────────────────────
// TestModuleQuestion
// ─────────────────────────────────────────────────────────────────
model TestModuleQuestion {
  id         String     @id @default(cuid())
  moduleId   String
  module     TestModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionId String
  question   Question   @relation(fields: [questionId], references: [id])
  order      Int

  @@unique([moduleId, questionId])
  @@index([moduleId, order])
}

// ─────────────────────────────────────────────────────────────────
// TestSession
// ─────────────────────────────────────────────────────────────────
model TestSession {
  id                 String    @id @default(cuid())
  testId             String
  test               Test      @relation(fields: [testId], references: [id])
  studentId          String?
  student            Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  currentModuleIndex Int       @default(0)
  answers            Json      @default("{}")
  timeRemaining      Json      @default("{}")
  routing            Json      @default("[]")
  results            Json?
  status             String    @default("active")
  isPreview          Boolean   @default(false)

  @@index([testId])
  @@index([testId, isPreview])
  @@index([status, isPreview])
  @@index([studentId, startedAt])
}
